    value: 10.17605/OSF.IO/6C5XB
    description: "The programme's project on OSF, where each document's canonical record and every version stand"
  - type: doi
    value: 10.5281/zenodo.24352688
    description: "This repository, archived on Zenodo at each release (all versions)"
license: Apache-2.0
